<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openamr_base_msgs</name>
  <version>0.0.0</version>
  <description>I8 base controller status, auxiliary device and fault messages for OpenAMRobot 2.0 (Proposed)</description>

  <maintainer email="info@botshare.ai">Botshare LTD</maintainer>
  <author email="evans@botshare.ai">Evans Klenam Kwashie-Seyram</author>

  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Common interface dependencies -->
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>

  <!-- Tests -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
